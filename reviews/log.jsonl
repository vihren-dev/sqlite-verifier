{"caller": "codex", "commit": "c86453d89489a8058953a9681eed122c9e825713", "date": "2026-10-06T14:30:36+00:00", "exit": 0, "files": ["build-support/tests.nix", "conformance/corpus.py", "conformance/corpus_acquisition.py", "conformance/corpus_evidence.py", "conformance/corpus_shards.py", "conformance/freeze_corpus.py", "conformance/freeze_validation.py", "conformance/measure_native.py", "conformance/native_bindings.py", "conformance/native_call_recording.py", "conformance/native_library.py", "conformance/native_record.py", "conformance/native_replay.py", "conformance/native_statements.py", "conformance/upstream_assertions.py", "conformance/upstream_binding_policy.py", "conformance/upstream_bindings.py", "conformance/upstream_bindings.tcl", "conformance/upstream_display.py", "conformance/upstream_evidence.py", "conformance/upstream_fidelity.py", "conformance/upstream_pilot.py", "conformance/upstream_proxy.tcl", "conformance/upstream_result_values.py", "conformance/workload_inputs.py", "docs/conformance-format-v2.md", "plans/20261006-exact-tcl-values.status.md", "reviews/log.jsonl", "tests/conformance_authored_boundaries_test.py", "tests/conformance_authored_queries_test.py", "tests/conformance_authored_review_test.py", "tests/conformance_authored_test.py", "tests/conformance_capture_test.py", "tests/conformance_freeze_test.py", "tests/conformance_native_bindings_test.py", "tests/conformance_streaming_test.py", "tests/conformance_tcl_bindings_test.py", "tests/conformance_tcl_precision_test.py", "tests/conformance_tcl_values_test.py", "tests/conformance_upstream_test.py", "tests/conformance_workload_clock_test.py", "tests/conformance_workload_test.py", "tests/nix_suites.json", "tests/upstream_binding_calls.test"], "findings": [{"id": "20261006T143036Z-c86453d8#1", "line": 40, "path": "conformance/upstream_binding_policy.py", "rule": "R11", "severity": "should", "text": "No test covers the refusals for historical acquisitions: a version 1 report or record that carries `tclBindingPolicy`, `tclCallsSha256`, `bindingRecordingVersion` or named slots, or a version 2 record whose recording extension was removed. Yet `docs/conformance-format-v2.md` says that relabeling or removing evidence \"cannot bypass that refusal\". Fix: add damage cases to the acquisition or freeze tests that relabel a version 2 report as version 1, and that remove the recording extension, and assert that `retained_binding_policy`, `retained_call_evidence` and `validate_capture_bindings` raise errors."}, {"id": "20261006T143036Z-c86453d8#2", "line": 157, "path": "conformance/native_call_recording.py", "rule": "R12", "severity": "should", "text": "`replay_arguments` is typed as returning `dict[str, Json]`, but it returns decoded `Row` tuples with `bytes`, and tuples from `migrationReadonlySpans`, which are not `Json`. Fix: declare a typed return (for example a `TypedDict` of the `record_sql` keyword arguments), so that the `**recording` call sites are type-checked."}, {"id": "20261006T143036Z-c86453d8#3", "line": 59, "path": "conformance/native_statements.py", "rule": "R1", "severity": "should", "text": "The policy that `onecolumn` and `exists` helpers run as read-only is a new set literal inside the statement loop, and the same literal is in `native_record.py` and `upstream_helpers.py`. Fix: define a named `READ_ONLY_TCL_HELPERS` constant with a docstring next to `TCL_SQL_HELPERS`, and use it in all three places."}, {"id": "20261006T143036Z-c86453d8#4", "line": 26, "path": "conformance/upstream_selection.py", "rule": "R4", "severity": "should", "text": "The commit replaced `implicit_binding_reasons` with the observed `binding_reasons`, but `candidate_reasons` keeps a fallback to the old token-only function for \"older candidates\". `iter_assertions` now always sets `implicitBindingReasons`, so that path is never used. Fix: remove the fallback and `implicit_binding_reasons`, and read `candidate[\"implicitBindingReasons\"]` directly."}, {"id": "20261006T143036Z-c86453d8#5", "line": 125, "path": "conformance/native_call_recording.py", "rule": "R10", "severity": "should", "text": "The new validation errors do not identify the record or call that failed, and do not tell the user what to do next. Examples are \"Invalid native binding recording version or fields\" and \"Invalid native binding replay guards\"; the wrapper in `corpus_shards.py` (\"Invalid corpus binding recording\") also hides the original cause. Fix: add the case name and the field that failed to these messages, and say that the user must recapture or refreeze the corpus record."}], "id": "20261006T143036Z-c86453d8", "kind": "review", "reviewer": "claude", "revision": "@-", "rules": {"R1": "62d446279093", "R10": "638d8cbd1df8", "R11": "5de19cdbbbc1", "R12": "99f66579f467", "R13": "da0926dafb88", "R2": "e5e78fb2a52a", "R3": "4f9188eadd60", "R4": "ea7ca17539eb", "R5": "b8613a2d693b", "R6": "5600dce59aef", "R7": "0b68df581c57", "R8": "b4168359c60d", "R9": "5a69196344d0"}, "well_formed": true}
